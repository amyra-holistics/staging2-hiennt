Dashboard ecommerce_dashboard_test_ai {
  title: 'Ecommerce Dashboard - Test AI'
  description: ''''''
  view: TabLayout {
    label: 'View 1'
    tab tab1: CanvasLayout {
      label: 'Business overview'
      width: 1850
      height: 1320
      grid_size: 20
      block v1 {
        position: pos(20, 290, 320, 120)
        layer: 3
      }
      block v2 {
        position: pos(360, 290, 320, 120)
        layer: 3
      }
      block v3 {
        position: pos(20, 430, 1810, 320)
        layer: 4
      }
      block v_1bbl {
        position: pos(20, 1040, 1810, 240)
        layer: 6
      }
      block v_785l {
        position: pos(20, 770, 1180, 250)
        layer: 5
      }
      block f_users_sign_up_at {
        position: pos(20, 170, 320, 100)
        layer: 2
      }
      block f_orders_created_at {
        position: pos(360, 170, 320, 100)
        layer: 2
      }
      block v_oray {
        position: pos(1225, 500, 300, 200)
        layer: 10
      }
      block t_3fu4 {
        position: pos(20, 20, 1810, 130)
        layer: 1
      }
      auto_expand_vertically: true
    }
  }
  theme {
    background {
      bg_color: '#fffefb'
    }
    canvas {
      border {
        border_width: 1
        border_radius: 12
        border_color: '#c5c0b1'
        border_style: 'solid'
      }
      background {
        bg_color: '#fffefb'
      }
      shadow: 'none'
      opacity: 1
    }
    block {
      label {
        font_family: 'Inter'
        font_color: '#201515'
        font_size: 14
        font_weight: 'medium'
        font_style: 'normal'
      }
      text {
        font_family: 'Inter'
        font_color: '#605d52'
        font_size: 14
        font_weight: 'normal'
        font_style: 'normal'
      }
      border {
        border_width: 1
        border_radius: 12
        border_color: '#c5c0b1'
        border_style: 'solid'
      }
      background {
        bg_color: '#f8f4f0'
      }
      padding: 16
      shadow: 'none'
      opacity: 1
    }
    viz {
      table {
        general {
          bg_color: '#fffefb'
          hover_color: '#f8f4f0'
          banding_color: '#f8f4f0'
          font_size: 12
          font_color: '#605d52'
          font_family: 'Inter'
          border_color: '#c5c0b1'
          border_width: 1
          grid_color: '#c5c0b1'
        }
        header {
          bg_color: '#201515'
          font_size: 12
          font_weight: 'bold'
          font_color: '#fffefb'
        }
      }
      metric_kpi {
        label {
          font_family: 'Inter'
          font_color: '#939084'
          font_size: 14
          font_weight: 'medium'
        }
        value {
          font_family: 'Inter'
          font_color: '#201515'
          font_size: 32
          font_weight: 'bold'
        }
        trend {
          positive {
            text {
              font_color: '#ff4f00'
            }
            background {
              bg_color: '#fff1e8'
            }
          }
          negative {
            text {
              font_color: '#201515'
            }
            background {
              bg_color: '#f3ece6'
            }
          }
          neutral {
            text {
              font_color: '#605d52'
            }
            background {
              bg_color: '#f8f4f0'
            }
          }
        }
      }
    }
  }
  block v1: VizBlock {
    label: 'Total Users'
    viz: MetricKpi {
      dataset: ecommerce
      theme {
        metric_kpi {
          label {
            font_family: 'Inter'
            font_color: '#939084'
            font_size: 14
            font_weight: 'medium'
          }
          value {
            font_family: 'Inter'
            font_color: '#201515'
            font_size: 32
            font_weight: 'bold'
          }
        }
      }
      value: VizFieldFull {
        label: 'Total Users'
        ref: r(ecommerce_orders.user_id)
        aggregation: 'count'
        format {
          type: 'number'
          pattern: '#,###'
        }
      }
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
    settings {
      hide_label: true
    }
  }
  block v2: VizBlock {
    label: 'Count of Order Id'
    viz: MetricKpi {
      dataset: ecommerce
      theme {
        metric_kpi {
          label {
            font_family: 'Inter'
            font_color: '#939084'
            font_size: 14
            font_weight: 'medium'
          }
          value {
            font_family: 'Inter'
            font_color: '#201515'
            font_size: 32
            font_weight: 'bold'
          }
        }
      }
      value: VizFieldFull {
        label: 'Total Orders'
        ref: r(ecommerce_order_items.order_id)
        aggregation: 'count'
        format {
          type: 'number'
          pattern: '#,###'
        }
      }
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
    settings {
      hide_label: true
    }
  }
  block v3: VizBlock {
    label: 'Total Users by Month Sign Up At and Gender'
    viz: ColumnChart {
      dataset: ecommerce
      theme {
      }
      x_axis: VizFieldFull {
        ref: r(ecommerce_users.sign_up_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      legend: VizFieldFull {
        ref: r(ecommerce_users.gender)
        format {
          type: 'text'
        }
      }
      y_axis {
        settings {
          show_data_label_by: 'value'
          stack_series_by: 'value'
        }
        series {
          field: VizFieldFull {
            label: 'Total Users'
            ref: r(ecommerce_users.id)
            aggregation: 'count'
            format {
              type: 'number'
              pattern: '#,###'
            }
          }
        }
      }
      settings {
        x_axis_show_null_datetime: true
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_785l: VizBlock {
    label: 'Gross sales and net sales'
    viz: CombinationChart {
      dataset: ecommerce
      x_axis: VizFieldFull {
        ref: r(ecommerce_orders.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        settings {
          show_data_label_by: 'value'
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(ecommerce.gross_sales)
            format {
              type: 'number'
              pattern: '#,###,,"M"'
            }
          }
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(ecommerce.net_sales)
            format {
              type: 'number'
              pattern: '#,###,,"M"'
            }
          }
        }
      }
      settings {
        x_axis_show_null_datetime: true
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_1bbl: VizBlock {
    label: 'Revenue by country'
    viz: BarChart {
      dataset: ecommerce
      calculation value_per_order {
        label: 'Value Per Order'
        formula: @aql revenue / total_orders;;
        calc_type: 'measure'
        data_type: 'number'
      }
      x_axis: VizFieldFull {
        label: 'Country'
        ref: r(ecommerce_countries.name)
        format {
          type: 'text'
        }
      }
      y_axis {
        settings {
          show_data_label_by: 'value'
        }
        series {
          field: VizFieldFull {
            ref: r(ecommerce.gross_sales)
            format {
              type: 'number'
              pattern: '#,###'
            }
          }
        }
      }
      settings {
        sort {
          field_index: 0
          direction: 'desc'
          type: 'series'
        }
        x_axis_label: 'Country'
        x_axis_show_null_datetime: true
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
    settings {
      hide_label: true
    }
  }
  block f_users_sign_up_at: FilterBlock {
    label: 'Users Sign Up At'
    type: 'field'
    source: FieldFilterSource {
      dataset: ecommerce
      field: r(ecommerce_users.sign_up_at)
    }
  }
  block f_orders_created_at: FilterBlock {
    label: 'Orders Created At'
    type: 'field'
    source: FieldFilterSource {
      dataset: ecommerce
      field: r(ecommerce_orders.created_at)
    }
  }
  block t_3fu4: TextBlock {
    content: @md # Ecommerce Overview
A clean snapshot of **user growth**, **order volume**, and **sales performance**.

Use the filters to narrow the time window, scan the KPI cards first, then review the trend and country-level sales breakdown below.;;
    theme {
      text {
        font_family: 'Inter'
        font_color: '#fffefb'
        font_size: 16
        font_weight: 'normal'
        font_style: 'normal'
      }
      border {
        border_width: 0
        border_radius: 12
        border_color: '#201515'
        border_style: 'solid'
      }
      background {
        bg_color: '#201515'
      }
      padding: 24
      shadow: 'none'
    }
  }
  interactions: [
    FilterInteraction {
      from: 'f_users_sign_up_at'
      to: [
        CustomMapping {
          block: [
            'v2',
            'v_785l',
            'v_1bbl',
            'v_oray',
            'f_orders_created_at'
          ]
          disabled: true
        }
      ]
    },
    FilterInteraction {
      from: 'f_orders_created_at'
      to: [
        CustomMapping {
          block: [
            'v1',
            'v3',
            'v_oray',
            'f_users_sign_up_at'
          ]
          disabled: true
        }
      ]
    }
  ]
}